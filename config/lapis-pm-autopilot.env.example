# Lapis PM - pipeline autopilot (the prodder) scoped env file EXAMPLE.
#
# Copy to ~/.config/lapis-pm/autopilot.env (chmod 600) on the host that runs
# the autopilot unit. The key-set contract is pinned here AND asserted by
# tests/test_autopilot.py: EXACTLY the five keys below.
#
# The autopilot unit is a perceive-and-write-state layer: it NEVER dispatches
# a leg and NEVER merges a PR. Its blast radius is a mem write + the Matrix
# page. Merges run under the daemon tick's credential, not this unit.

# The mem store (the authoritative decision ledger).
MEM_DB_PATH=/path/to/mem.db
LAPIS_PM_OWNED_MEM_STORE=/path/to/owned-mem.db

# The Matrix page sink. Pushover is FORBIDDEN for autopilot pages; the page
# goes to this Matrix sink.
MATRIX_HOMESERVER_URL=https://matrix.example
MATRIX_ACCESS_TOKEN=<your-…oken>
MATRIX_ROOM_ID=!placeholder:example
