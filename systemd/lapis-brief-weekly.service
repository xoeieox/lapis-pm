[Unit]
Description=Lapis PM — weekly state brief (Monday 08:30 PT)
After=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/srv/lapis/lapis-pm
ExecStart=/usr/bin/python3 -m lapis_pm.cli brief --period weekly
EnvironmentFile=-/data/agents/config/conductor.env
Environment=PYTHONPATH=/data/agents/scripts:/home/user/.local/lib/python3.12/site-packages
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
