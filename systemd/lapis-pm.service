[Unit]
Description=Lapis PM — tick all bound targets (perceive/score/encode/decide/act)
After=network-online.target docker.service

[Service]
Type=oneshot
User=user
WorkingDirectory=/srv/git/lapis-pm
ExecStart=/usr/bin/python3 -m lapis_pm.cli tick --all
EnvironmentFile=-/data/agents/config/conductor.env
# Phala TEE key for the node2 corroboration leg (lapis-pm-panel-leg-survival-v0,
# Change 2). The `-` prefix makes a missing file non-fatal at unit start — node2
# then fails closed per leg; the local legs never read this key.
EnvironmentFile=-/data/agents/config/phala.env
# /data/agents/scripts on PYTHONPATH is legacy — only needed for chub_broker until
# it migrates out of conductor. shaper.py also adds this to sys.path defensively.
Environment=PYTHONPATH=/data/agents/scripts:/home/user/.local/lib/python3.12/site-packages
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin:/home/user/.local/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# D6b (attestation-contract-v0 leg 2): 300s killed the tick pass mid-run
# (the tick-starvation class — the pass starved by its own unit timeout).
# 1800s bounds a genuinely hung pass (the dedicated lapis-pm-stall-check
# unit catches the stall; the cursor threshold is a ~3-7x-margin tripwire
# for a dead unit).
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
